{% set sc = site.scenes.embedding %}
<section class="section education" id="education" data-scene="embedding" data-fig="{{ sc.fig | roman }}" data-caption="{{ sc.caption }}">
  <div class="wrap">
    <div class="sec-head">
      <span class="sec-label" data-decode>Education</span>
    </div>
    <ol class="edu">
      {% for edu in education %}
      <li class="edu-item reveal">
        <span class="edu-when">{{ edu.date }}</span>
        <div>
          <h3 class="edu-name">{{ edu.institution }}</h3>
          <p class="edu-detail">{{ edu.detail }}{% if edu.chip %} <span class="stain">· {{ edu.chip }}</span>{% endif %}</p>
          {% if edu.subDetail %}<p class="edu-sub">{{ edu.subDetail }}</p>{% endif %}
        </div>
      </li>
      {% endfor %}
    </ol>
  </div>
</section>
