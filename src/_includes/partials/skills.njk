<section class="section toolkit" id="toolkit" data-scene="embedding">
  <div class="wrap">
    <div class="sec-head">
      <span class="sec-label" data-decode>Toolkit</span>
    </div>
    <div class="tools">
      {% for group in skills %}
      <div class="tool-group reveal">
        <h3 class="tool-cat">{{ group.category }}</h3>
        <ul>
          {% for item in group.items %}<li>{{ item }}</li>{% endfor %}
        </ul>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
