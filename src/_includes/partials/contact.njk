<section id="contact">
  <div class="wrap">
    <div class="contact-panel reveal">
      <div class="eyebrow" style="justify-content:center;">07 / Contact</div>
      <h2>{{ site.contact.heading }}</h2>
      <p>{{ site.contact.body }}</p>
      <div class="contact-links">
        <a class="btn btn-primary" href="mailto:{{ site.email }}">Email Me →</a>
        <a class="btn btn-ghost" href="{{ site.links.linkedin }}" target="_blank" rel="noopener">LinkedIn</a>
        <a class="btn btn-ghost" href="{{ site.links.github }}" target="_blank" rel="noopener">GitHub</a>
        <a class="btn btn-ghost" href="{{ site.links.oldPortfolio }}" target="_blank" rel="noopener">Old Portfolio</a>
      </div>
    </div>
  </div>
</section>
