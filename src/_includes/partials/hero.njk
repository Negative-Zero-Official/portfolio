{% set sc = site.scenes.neuron %}
<section class="hero" id="top" data-scene="neuron" data-fig="{{ sc.fig | roman }}" data-caption="{{ sc.caption }}">
  <div class="wrap hero-inner">
    <p class="kicker" data-decode>{{ site.hero.kicker }}</p>
    <h1 class="hero-name">
      <span class="hero-line"><span>Prahlad</span></span>
      <span class="hero-line"><span><em>Gaitonde</em></span></span>
    </h1>
    <div class="hero-foot">
      <p class="hero-statement">{{ site.hero.line }}</p>
      <p class="hero-lede">{{ site.hero.lede | mdInline | safe }}</p>
    </div>
  </div>
</section>
