<header class="nav">
  <a class="nav-mark" href="{{ '/' | url }}" aria-label="{{ site.name }}, home">
    <span class="nav-initials">{{ site.initials }}</span>
    <span class="nav-name">{{ site.name }}</span>
  </a>
  <nav class="nav-links" aria-label="Sections">
    <a href="{{ '/' | url }}#about">About</a>
    <a href="{{ '/' | url }}#experience">Experience</a>
    <a href="{{ '/' | url }}#work">Work</a>
    <a href="{{ '/' | url }}#toolkit">Toolkit</a>
    <a href="{{ '/' | url }}#contact">Contact</a>
  </nav>
  <span class="nav-status"><span class="spike-dot" aria-hidden="true"></span>{{ site.status }}</span>
  <button class="nav-menu" id="navMenu" type="button" aria-expanded="false" aria-controls="navSheet">Menu</button>
</header>

{# Small screens: the same links as a full-screen sheet #}
<nav class="nav-sheet" id="navSheet" aria-label="Sections">
  <a href="{{ '/' | url }}#about">About</a>
  <a href="{{ '/' | url }}#experience">Experience</a>
  <a href="{{ '/' | url }}#work">Work</a>
  <a href="{{ '/' | url }}#toolkit">Toolkit</a>
  <a href="{{ '/' | url }}#contact">Contact</a>
</nav>
